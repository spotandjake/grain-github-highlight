module Main

enum Temperature {
  Celsius(Number),
  Fahrenheit(Number),
}

let toCelsius = temperature => match (temperature) {
  Celsius(c) => c,
  Fahrenheit(f) => (f - 32.0) * 5.0 / 9.0,
}

let describe = temperature => {
  let celsius = toCelsius(temperature)

  if (celsius < 0.0) {
    "Freezing!"
  } else if (celsius > 30.0) {
    "It's hot!"
  } else {
    "Nice weather!"
  }
}
