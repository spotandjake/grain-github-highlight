{
  "name": "github-grain-highlight",
  "version": "2.0.0",
  "description": "Grain syntax highlighter for github",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist .wxt",
    "format": "prettier --write src/**/*.ts",
    "lint": "prettier --check src/**/*.ts",
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "pack": "npm run pack:chrome && npm run pack:firefox",
    "pack:chrome": "wxt zip",
    "pack:firefox": "wxt zip -b firefox"
  },
  "author": "spotandjake",
  "contributors": [
    "Kara-Zor-El <kara.wilson.2005.08@gmail.com>"
  ],
  "license": "MIT",
  "devDependencies": {
    "@treelight/browser": "^0.5.0",
    "@treelight/theme-github-dark": "^0.5.0",
    "@types/chrome": "^0.2.5",
    "prettier": "^3.5.0",
    "tree-sitter-grain": "^0.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wxt": "^0.21.5"
  }
}
